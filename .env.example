# Server Configuration
PORT=3001
NODE_ENV=development

# GitHub (optional)
GITHUB_TOKEN=

# AI / LLM Configuration (optional, for AI scoring)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_PROVIDERS=openrouter,groq,openai,anthropic
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional explicit model per fallback provider
# LLM_OPENAI_MODEL=gpt-4o-mini
# LLM_GROQ_MODEL=llama-3.3-70b-versatile

# Database (required)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres
# Optional explicit model/base URL for OpenRouter
# LLM_OPENROUTER_MODEL=openai/gpt-4o-mini
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Slack Integration (optional)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Apify (LinkedIn scraper - optional)
APIFY_API_TOKEN=

# Twitter (optional)
TWITTER_BEARER_TOKEN=
